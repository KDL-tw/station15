# Encore Environment Variables
# These will be used when running Encore locally
# For production, set these as Encore secrets: encore secret set --type secret KEY_NAME

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE=your-supabase-service-role-key

# Feature Flags
FEATURE_DEMO_SIM=true
FEATURE_FAKE_AUTH=true

# Authentication
ENGINE_SHARED_SECRET=your-shared-secret-for-demo-auth

